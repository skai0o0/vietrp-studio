# VietRP Studio environment. Copy to backend/.env (dev) or /etc/vietrp/vietrp.env (prod, mode 600).
# Placeholders only: never commit real values.

# PostgreSQL connection (asyncpg driver is required).
DATABASE_URL=postgresql+asyncpg://vietrp:CHANGE_ME@127.0.0.1:5432/vietrp

# Mixed into the vault lookup HMAC. At least 32 bytes. Generate: openssl rand -hex 32
# Losing it makes every vault unreachable, so back it up separately from database dumps.
VIETRP_SERVER_PEPPER=CHANGE_ME_64_HEX_CHARS

# Secret for session handling. At least 32 bytes. Generate: openssl rand -hex 32
VIETRP_SESSION_SECRET=CHANGE_ME_64_HEX_CHARS

# "dev" or "prod". prod turns on Secure cookies and turns off CORS.
VIETRP_ENV=dev

# Optional overrides (defaults live in backend/app/core/config.py):
# VIETRP_COOKIE_SECURE=true
# VIETRP_SESSION_TTL_SECONDS=604800
# VIETRP_ARGON2_TIME_COST=3
# VIETRP_ARGON2_MEMORY_COST_KIB=65536
# VIETRP_ARGON2_PARALLELISM=2
# VIETRP_PASSPHRASE_MIN_CHARS=16
# VIETRP_PASSPHRASE_MIN_WORDS=4
# VIETRP_PASSPHRASE_MIN_CHARS_WITH_WORDS=12
# VIETRP_UNLOCK_RATE_LIMIT_ATTEMPTS=10
# VIETRP_UNLOCK_RATE_LIMIT_WINDOW_SECONDS=300
# VIETRP_TRUSTED_PROXY_HOSTS=["127.0.0.1","::1"]
# VIETRP_ALLOWED_SECRET_NAMES=["OPENROUTER_API_KEY"]
# VIETRP_OPENROUTER_BASE_URL=https://openrouter.ai
# VIETRP_HTTP_TIMEOUT_SECONDS=120
# VIETRP_HTTP_CONNECT_TIMEOUT_SECONDS=10
# VIETRP_LLM_MAX_RETRIES=3
# VIETRP_LLM_BACKOFF_BASE_SECONDS=2.0
# VIETRP_DECISIONS_MAX_QUESTIONS=40
# VIETRP_SSE_PING_INTERVAL_SECONDS=15
# VIETRP_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# VIETRP_FRONTEND_DIST_DIR=../frontend/dist

# Tests only: a scratch PostgreSQL database for migration tests (it is wiped). Leave unset to skip them.
# VIETRP_TEST_DATABASE_URL=postgresql+asyncpg://vietrp:CHANGE_ME@127.0.0.1:5432/vietrp_test
