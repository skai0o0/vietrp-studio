# /etc/vietrp/vietrp.env: production environment for vietrp-api.service.
#
# Install as root with mode 600:
#   sudo install -m 600 -o root -g root /opt/vietrp/deploy/scripts/env.example /etc/vietrp/vietrp.env
#   sudoedit /etc/vietrp/vietrp.env
#
# Rules: one KEY=VALUE per line, no spaces around "=", no quotes.
# Never commit the real file. Back up VIETRP_SERVER_PEPPER separately from the database dumps.
# The OpenRouter API key is not set here. It is entered in the app and stored encrypted in the vault.

# Production mode: secure cookies, CORS off.
VIETRP_ENV=prod

# PostgreSQL 17 on localhost, role and database "vietrp" (see deploy/README.md).
# Replace the password with: openssl rand -hex 32
DATABASE_URL=postgresql+asyncpg://vietrp:<generate: openssl rand -hex 32>@127.0.0.1:5432/vietrp

# Server pepper, at least 32 bytes. Generate once and never change it:
# changing it makes every existing vault unreachable.
VIETRP_SERVER_PEPPER=<generate: openssl rand -hex 32>

# Session secret, at least 32 bytes.
VIETRP_SESSION_SECRET=<generate: openssl rand -hex 32>
