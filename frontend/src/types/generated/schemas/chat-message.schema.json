        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "passed",
        "score",
        "criteria",
        "attempt"
      ],
      "title": "DirectorVerdict",
      "type": "object"
    },
    "MessageVariantOut": {
