{
  "$defs": {
    "Location": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9_]{1,40}$",
          "title": "Id",
          "type": "string"
        },
        "level": {
          "enum": [
            "galaxy",
            "star_system",
            "planet",
            "country",
            "province",
            "district",
            "area",
            "place"
          ],
          "title": "Level",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9_]{1,40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        }
      },
      "required": [
        "id",
        "level",
        "name"
      ],
      "title": "Location",
      "type": "object"
    },
    "Opening": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_]{1,40}$",
          "title": "Id",
          "type": "string"
        },
        "location_id": {
          "pattern": "^[a-z0-9_]{1,40}$",
          "title": "Location Id",
          "type": "string"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "player_role": {
          "default": "",
          "title": "Player Role",
          "type": "string"
        },
        "present_ids": {
          "items": {
            "pattern": "^[a-z0-9_]{1,40}$",
            "type": "string"
          },
          "title": "Present Ids",
          "type": "array"
        },
        "tension": {
          "default": 0,
          "maximum": 4,
          "minimum": 0,
          "title": "Tension",
          "type": "integer"
        },
        "time": {
          "default": "",
          "title": "Time",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "location_id"
      ],
      "title": "Opening",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "vietrp-world",
      "default": "vietrp-world",
      "title": "Format",
      "type": "string"
    },
    "locations": {
      "items": {
        "$ref": "#/$defs/Location"
      },
      "title": "Locations",
      "type": "array"
    },
    "lorebook_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Lorebook Ids",
      "type": "array"
    },
    "name": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "openings": {
      "items": {
        "$ref": "#/$defs/Opening"
      },
      "title": "Openings",
      "type": "array"
    },
    "rules": {
      "default": "",
      "title": "Rules",
      "type": "string"
    },
    "spec_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Spec Version",
      "type": "string"
    },
    "tags": {
      "items": {
        "maxLength": 32,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Tags",
      "type": "array"
    }
  },
  "required": [
    "name"
  ],
  "title": "VietrpWorld",
  "type": "object"
}
