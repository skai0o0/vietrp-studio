    "name": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "personality": {
      "default": "",
      "title": "Personality",
      "type": "string"
    },
    "relationships": {
      "$ref": "#/$defs/Relationships"
