      "default": "",
      "maxLength": 140,
      "title": "Tagline",
      "type": "string"
    },
    "tags": {
      "items": {
        "maxLength": 32,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Tags",
      "type": "array"
    }
  },
  "required": [
    "name"
  ],
  "title": "VietrpCard",
  "type": "object"
}
