          "$ref": "#/$defs/CreatorDeltaEvent"
        },
        {
          "$ref": "#/$defs/CreatorMessageEvent"
        },
        {
          "$ref": "#/$defs/CreatorRawEvent"
        },
        {
          "$ref": "#/$defs/CreatorFormattedEvent"
        },
        {
          "$ref": "#/$defs/CreatorValidatedEvent"
        },
        {
          "$ref": "#/$defs/CreatorJudgedEvent"
        },
        {
          "$ref": "#/$defs/NoticeEvent"
        },
        {
          "$ref": "#/$defs/UsageEvent"
        },
        {
          "$ref": "#/$defs/PingEvent"
